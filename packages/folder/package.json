{
	"name": "@epicenter/folder",
	"version": "0.0.1",
	"private": true,
	"description": "File-authoritative folders: Markdown tables, kv.json, ordinary files, and Git history, opened in a browser, in the Tauri desktop app, or over a directory in Bun.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./browser": "./src/browser.ts",
		"./tauri": "./src/tauri.ts",
		"./bun": "./src/bun.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test --isolate",
		"test:native": "EPICENTER_FOLDER_BRIDGE=1 bun test --isolate src/tauri-native.test.ts",
		"gen:vectors": "bun src/git/commit-subject-vectors.ts"
	},
	"dependencies": {
		"@epicenter/definition": "workspace:*",
		"@epicenter/principal": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"buffer": "^6.0.3",
		"diff": "^8.0.4",
		"ignore": "^7.0.5",
		"isomorphic-git": "1.38.5",
		"jsonc-parser": "^3.3.1",
		"just-bash": "3.4.2",
		"nanoid": "catalog:",
		"wellcrafted": "catalog:",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.5",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
