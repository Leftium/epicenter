{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "departure-production",
	"description": "Capture and Todos read and answer the host's quit or restart round.",
	"local": false,
	"windows": ["capture", "todos"],
	"remote": {
		"urls": ["http://127.0.0.1:39130"]
	},
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"allow-departure-status",
		"allow-departure-answer"
	]
}
