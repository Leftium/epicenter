{
	"name": "@epicenter/capture-app",
	"description": "File-first captures: one Markdown file per capture, with its thoughts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		"./bridge": "./src/lib/bridge/contract.ts",
		"./native": "./native/index.ts"
	},
	"imports": {
		"#platform/folder": {
			"epicenter-host": "./src/lib/platform/folder.epicenter-host.ts",
			"default": "./src/lib/platform/folder.browser.ts"
		},
		"#platform/auth": {
			"epicenter-host": "./src/lib/platform/auth.epicenter-host.ts",
			"default": "./src/lib/platform/auth.browser.ts"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"build:epicenter": "EPICENTER_HOST=1 bun run build",
		"preview": "vite preview",
		"smoke:browser": "bun scripts/browser-smoke.ts",
		"harness:native": "bun scripts/native-harness.ts",
		"harness:recovery": "bun scripts/recovery-harness.ts",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter-host.json && tsc -p tsconfig.scripts.json",
		"test": "bun test --isolate"
	},
	"dependencies": {
		"@epicenter/app": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/capture": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"buffer": "^6.0.3"
	},
	"devDependencies": {
		"@epicenter/vite-config": "workspace:*",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/bun": "catalog:",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
