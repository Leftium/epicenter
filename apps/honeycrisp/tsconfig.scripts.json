{
	// The Bun folder host and build scripts. They import the bridge contract
	// and the data declaration from `src/lib`, and nothing that needs SvelteKit.
	"extends": "../../tsconfig.dom.json",
	"compilerOptions": {
		"types": ["bun"],
		"noEmit": true
	},
	"include": ["host/**/*.ts", "scripts/**/*.ts"]
}
