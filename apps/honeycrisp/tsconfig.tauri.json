{
	// Typechecks the `#platform/*` desktop leaf. `tsconfig.json` resolves the
	// default (browser) leaf, so the desktop one is only checked when the
	// resolver is flipped here. `bun run typecheck` runs both.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"customConditions": ["tauri"]
	}
}
