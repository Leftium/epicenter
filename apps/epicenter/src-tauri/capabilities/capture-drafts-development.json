{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "capture-drafts-development",
	"description": "Capture answers host quit requests after saving or explicit draft discard.",
	"local": false,
	"windows": [
		"capture"
	],
	"remote": {
		"urls": [
			"http://127.0.0.1:*"
		]
	},
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"allow-capture-quit-answer"
	]
}
