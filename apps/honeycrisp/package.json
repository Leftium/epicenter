{
	"name": "@epicenter/honeycrisp",
	"description": "File-authoritative Markdown notes with a rich-text editor and a standalone desktop shell",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"imports": {
		"#platform/notes-host": {
			"tauri": "./src/lib/platform/notes-host.tauri.ts",
			"default": "./src/lib/platform/notes-host.browser.ts"
		}
	},
	"scripts": {
		"dev": "tauri dev",
		"dev:ui": "vite dev",
		"build": "NODE_ENV=production vite build",
		"build:desktop-ui": "HONEYCRISP_DESKTOP=1 bun run build",
		"build:desktop": "tauri build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"tauri": "tauri",
		"test": "bun test --isolate --conditions=browser ./src",
		"test:native": "bun run build:desktop-ui && cargo test --locked --manifest-path src-tauri/Cargo.toml && cargo build --locked --manifest-path src-tauri/Cargo.toml --example harness && bun test --isolate --conditions=browser ./native-tests",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.tauri.json && tsc -p tsconfig.scripts.json"
	},
	"devDependencies": {
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"@types/markdown-it": "^14.0.0",
		"fake-indexeddb": "^6.2.5",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/constants": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"bits-ui": "catalog:",
		"buffer": "^6.0.3",
		"date-fns": "catalog:",
		"markdown-it": "^14.0.0",
		"prosemirror-commands": "^1.6.0",
		"prosemirror-history": "^1.5.0",
		"prosemirror-inputrules": "^1.4.0",
		"prosemirror-keymap": "^1.2.0",
		"prosemirror-markdown": "^1.13.0",
		"prosemirror-model": "^1.25.0",
		"prosemirror-schema-basic": "^1.2.0",
		"prosemirror-schema-list": "^1.4.0",
		"prosemirror-state": "^1.4.0",
		"prosemirror-view": "^1.41.0",
		"wellcrafted": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
