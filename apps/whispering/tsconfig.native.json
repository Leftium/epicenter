{
	// Bun entrypoints: the folder host and the sidecar build script. They import
	// the page's platform-free modules, so the DOM lib is present for `fetch`
	// and `Blob`; nothing here runs in the page.
	"extends": "../../tsconfig.dom.json",
	"compilerOptions": {
		"types": ["bun"],
		"noEmit": true
	},
	"include": ["native/**/*.ts", "scripts/**/*.ts"]
}
