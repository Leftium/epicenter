{
	"name": "@epicenter/todos",
	"description": "File-first todos: Markdown rows, browser Git history, and a folder terminal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#platform/folder": {
			"epicenter-host": "./src/lib/platform/folder.epicenter-host.ts",
			"default": "./src/lib/platform/folder.browser.ts"
		}
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:ui": "vite dev",
		"dev:git": "bun server/git-server.ts",
		"native": "bun scripts/native.ts",
		"build": "NODE_ENV=production vite build",
		"build:epicenter": "EPICENTER_HOST=1 bun run build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test --isolate",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter-host.json && tsc -p tsconfig.scripts.json"
	},
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/folder": "workspace:*",
		"buffer": "^6.0.3",
		"wellcrafted": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
