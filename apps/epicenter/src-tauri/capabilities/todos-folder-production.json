{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "todos-folder-production",
	"description": "Todos reads and saves the folder registered by the Rust shell.",
	"local": false,
	"windows": ["todos"],
	"remote": {
		"urls": ["http://127.0.0.1:39130"]
	},
	"permissions": [
		"epicenter-folder:default",
		"core:event:allow-listen",
		"core:event:allow-unlisten"
	]
}
